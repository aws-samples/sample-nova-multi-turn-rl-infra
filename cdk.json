    "eks_admin_role_arn": "",
    "target_cluster_name": "",
    "target_eks_cluster_name": "",
    "target_instance_type": "ml.p5.48xlarge",
    "target_instance_count": "2",
    "training_method": "RFT_MULTITURN_FULL",
    "max_steps": 10,
    "generation_replicas": 4,
    "global_batch_size": 64,
    "max_new_tokens": 4096,

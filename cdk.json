{
  "app": "python3 app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements*.txt",
      "source.bat",
      "**/__pycache__",
      "**/*.pyc",
      "cdk.out",
      ".venv"
    ]
  },
  "context": {
    "stack_name": "NovaMultiTurnRlStack",
    "region": "us-east-1",
    "sdk_resource_prefix": "",
    "instance_type": "ml.p5.48xlarge",
    "instance_count": 10,
    "nova_model": "NOVA_LITE_2",
    "vpc_cidr": "10.0.0.0/16",
    "project_tag": "",
    "environment_tag": "development",
    "retain_bucket": "true",
    "vf_env_id": "wordle",
    "reward_cpu": "2048",
    "reward_memory": "4096",
    "use_custom_env": "false",
    "custom_env_id": "my-custom-env",
